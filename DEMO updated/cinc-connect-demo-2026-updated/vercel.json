{
  "buildCommand": "echo done",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/krj",
      "destination": "/krj/index.html"
    },
    {
      "source": "/krj/(.*)",
      "destination": "/krj/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
