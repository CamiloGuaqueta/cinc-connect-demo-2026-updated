{
  "buildCommand": "echo done",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/cwd",
      "destination": "/cwd/index.html"
    },
    {
      "source": "/cwd/(.*)",
      "destination": "/cwd/index.html"
    },
    {
      "source": "/spinnaker",
      "destination": "/spinnaker/index.html"
    },
    {
      "source": "/spinnaker/(.*)",
      "destination": "/spinnaker/index.html"
    },
    {
      "source": "/insight",
      "destination": "/insight/index.html"
    },
    {
      "source": "/insight/(.*)",
      "destination": "/insight/index.html"
    },
    {
      "source": "/krj",
      "destination": "/krj/index.html"
    },
    {
      "source": "/krj/(.*)",
      "destination": "/krj/index.html"
    },
    {
      "source": "/avantstay",
      "destination": "/avantstay/index.html"
    },
    {
      "source": "/avantstay/(.*)",
      "destination": "/avantstay/index.html"
    },
    {
      "source": "/lagovista",
      "destination": "/lagovista/index.html"
    },
    {
      "source": "/lagovista/(.*)",
      "destination": "/lagovista/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
